{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H3 City Hex Polygons FeatureCollection",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "crs": {
      "type": "object",
      "required": ["type", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "name"
        },
        "properties": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^urn:ogc:def:crs:OGC:1\\.3:CRS84$"
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/feature" }
    }
  },
  "definitions": {
    "feature": {
      "type": "object",
      "required": ["type", "properties", "geometry"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "properties": {
          "type": "object",
          "required": ["index", "centroid_lat", "centroid_lon", "resolution"],
          "additionalProperties": false,
          "properties": {
            "index": {
              "type": "string",
              "pattern": "^[0-9a-f]{15}$"
            },
            "centroid_lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "centroid_lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "resolution": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}